# Copy to .env and fill in. All settings read from env (12-factor).

DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# Local dev default is sqlite if DATABASE_URL is unset; docker-compose overrides this.
DATABASE_URL=postgres://bytedocker:bytedocker@localhost:5432/bytedocker
REDIS_URL=redis://localhost:6379/0

# Encrypts Mailbox OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1

# True = run Celery tasks inline (local dev without worker/redis)
CELERY_TASK_ALWAYS_EAGER=false

# --- Mailbox OAuth (Phase 2) -------------------------------------------------
# Public base URL — used to build OAuth redirect URIs (register
# <BASE_URL>/settings/mailboxes/gmail/callback/ in the Google Cloud console).
BASE_URL=http://localhost:8000

# Google Cloud OAuth client (web). Scopes: gmail.send + gmail.readonly.
# Leave blank to keep the connect button disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local-dev only: allow the OAuth code exchange over plain http (oauthlib
# refuses http redirect URIs otherwise). Never set in production.
# OAUTHLIB_INSECURE_TRANSPORT=1
